#!/usr/bin/env python3
"""Configured public entrypoint for controller, node, mode, and DNS/TUN guard tools."""
from __future__ import annotations

import argparse
import fcntl
import os
import sys
from pathlib import Path

from recipient_config import load


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", required=True, type=Path)
    parser.add_argument("tool", choices=("check-config", "controller", "nodes", "mode", "guard", "setup"))
    parser.add_argument("arguments", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    try:
        config = load(args.config)
    except (OSError, ValueError, TypeError) as error:
        parser.error(str(error))
    if args.tool == "check-config":
        print("Configuration valid; no runtime reads, requests, or writes")
        return 0
    root = Path(__file__).resolve().parent
    scripts = {"controller": "clash_controller.py", "nodes": "clash_auto_switch_macos.py",
               "mode": "executable_switch_clash_mode_macos.sh", "guard": "clash_dns_tun_guard.py",
               "setup": "setup_guard.py"}
    arguments = args.arguments
    if args.tool == "nodes" and not any(v in arguments for v in ("--help", "-h")):
        for index, value in enumerate(arguments):
            if value.startswith("--tun-mode=") and value.split("=", 1)[1] != "auto":
                parser.error("Use mode tun/system for a reversible DNS transition; nodes uses auto")
            if value == "--tun-mode" and index + 1 < len(arguments) and arguments[index + 1] != "auto":
                parser.error("Use mode tun/system for a reversible DNS transition; nodes uses auto")
        arguments = ["--groups", ",".join(config["groups"]), "--fallback-regions",
                     ",".join(config["fallback_regions"]), "--excluded-regions",
                     ",".join(config["excluded_regions"]), *arguments]
    interpreter = "/bin/bash" if args.tool == "mode" else config["python_executable"]
    command = [interpreter, str(root / scripts[args.tool]), *arguments]
    mutation = (
        args.tool == "nodes" and "--dry-run" not in arguments
        or args.tool == "mode" and bool(arguments) and arguments[0] in ("tun", "system", "sys")
    ) and not any(v in arguments for v in ("--help", "-h"))
    if mutation:
        lock = Path(config["mutex_path"]).resolve()
        raw = os.environ.get("MACOS_HOME_MUTEX_FD", "")
        held = False
        if raw.isdecimal() and os.environ.get("MACOS_HOME_MUTEX_LOCK_PATH") == str(lock):
            try:
                descriptor = int(raw)
                current, expected = os.fstat(descriptor), lock.stat()
                held = (current.st_dev, current.st_ino) == (expected.st_dev, expected.st_ino)
                if held:
                    fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                held = False
        if not held:
            executable = config["mutex_executable"]
            if not os.path.isfile(executable) or not os.access(executable, os.X_OK):
                parser.error("Configured mutex executable is missing; no mutation executed")
            os.environ["MACOS_HOME_MUTEX_PATH"] = str(lock)
            os.execve(executable, [executable, "--", sys.executable, str(Path(__file__).resolve()),
                                  *sys.argv[1:]], os.environ.copy())
    os.execvpe(command[0], command, os.environ.copy())


if __name__ == "__main__":
    raise SystemExit(main())
