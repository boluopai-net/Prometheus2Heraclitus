#!/usr/bin/env python3
from __future__ import annotations

import errno
import fcntl
import os
import sys
from pathlib import Path

EXIT_FAILURE = 1
EXIT_USAGE = 2
EXIT_BUSY = 75
FD_ENV = "MACOS_HOME_MUTEX_FD"
PATH_ENV = "MACOS_HOME_MUTEX_LOCK_PATH"
# Leave the conventional shell scratch descriptors (3-9) available to child tools.
MIN_INHERITED_FD = 64


def same_file(descriptor: int, path: Path) -> bool:
    try:
        descriptor_stat = os.fstat(descriptor)
        path_stat = path.stat()
    except OSError:
        return False
    return (descriptor_stat.st_dev, descriptor_stat.st_ino) == (
        path_stat.st_dev,
        path_stat.st_ino,
    )


def inherited_fd(lock_path: Path) -> int | None:
    raw = os.environ.get(FD_ENV)
    if not raw or not raw.isdecimal():
        return None
    descriptor = int(raw)
    if os.environ.get(PATH_ENV) != str(lock_path):
        return None
    if not same_file(descriptor, lock_path):
        return None
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        os.set_inheritable(descriptor, True)
    except OSError:
        return None
    return descriptor


def open_lock_fd(lock_path: Path) -> int:
    original = os.open(
        lock_path,
        os.O_RDWR | os.O_CREAT | getattr(os, "O_CLOEXEC", 0),
        0o600,
    )
    try:
        os.fchmod(original, 0o600)
        descriptor = fcntl.fcntl(original, fcntl.F_DUPFD, MIN_INHERITED_FD)
    finally:
        os.close(original)
    try:
        os.set_inheritable(descriptor, True)
    except OSError:
        os.close(descriptor)
        raise
    return descriptor


def usage() -> int:
    print("usage: macos-home-mutex [--nonblocking] -- <argv...>", file=sys.stderr)
    return EXIT_USAGE


def main(argv: list[str]) -> int:
    if argv == ["--help"]:
        print("macos-home-mutex [--nonblocking] -- <argv...>; requires MACOS_HOME_MUTEX_PATH")
        return 0
    nonblocking = False
    if argv and argv[0] == "--nonblocking":
        nonblocking = True
        argv = argv[1:]
    if not argv or argv[0] != "--" or len(argv) == 1:
        return usage()
    command = argv[1:]
    configured_path = os.environ.get("MACOS_HOME_MUTEX_PATH")
    if not configured_path or not Path(configured_path).is_absolute():
        print("Set MACOS_HOME_MUTEX_PATH to the recipient's shared absolute lock path", file=sys.stderr)
        return EXIT_USAGE
    lock_path = Path(configured_path).resolve()
    descriptor = inherited_fd(lock_path)
    if descriptor is None:
        lock_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        try:
            descriptor = open_lock_fd(lock_path)
            flags = fcntl.LOCK_EX | (fcntl.LOCK_NB if nonblocking else 0)
            fcntl.flock(descriptor, flags)
        except OSError as exc:
            if descriptor is not None:
                os.close(descriptor)
            if nonblocking and exc.errno in {errno.EACCES, errno.EAGAIN}:
                return EXIT_BUSY
            print(f"macos-home-mutex: {exc}", file=sys.stderr)
            return EXIT_FAILURE
        os.environ[FD_ENV] = str(descriptor)
        os.environ[PATH_ENV] = str(lock_path)
    try:
        os.execvpe(command[0], command, os.environ.copy())
    except OSError as exc:
        print(f"macos-home-mutex: {exc}", file=sys.stderr)
        return EXIT_FAILURE


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
